# ==========================================
# JANSETU ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================

# HTTP Server Port
PORT=3000

# Application Public URL (used in email verification links)
APP_URL=http://localhost:3000

# Cryptographic Token Secret (HMAC SHA-256 for secure tokens)
AUTH_SECRET=jansetu_production_secure_secret_key_2026_xyz

# Resend Email Provider Configuration
# Sign up at https://resend.com to generate your API key
# Leave blank for local development simulation (logs links to console)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
